# Salin file ini jadi .env dan isi dengan nilai aslimu
PORT_SERVER=5000
EMAIL_PENGIRIM=
KUNCI_EMAIL=
ADMIN_EMAIL_UTAMA=

# Berapa menit user boleh diam sebelum otomatis logout (idle timeout)
SESSION_TIMEOUT_MINUTES=15

# 🟢 AI Assistant "Lumina" sekarang pakai Groq (gratis, cepat, OpenAI-compatible).
# Daftar & buat key di https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
